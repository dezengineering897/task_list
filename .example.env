# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real keys.

# --- Server binding (fixes bandit B104) ---
# Only used when running `python app.py` directly (the Docker image binds
# gunicorn to 0.0.0.0 inside the container regardless of this value, which
# is safe because it's the container's own isolated network namespace).
# Leave as 127.0.0.1 unless you specifically need the dev server reachable
# from other devices on your network.
FLASK_RUN_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# --- Where the SQLite file is stored ---
# DATA_DIR=./data

# --- EmailJS configuration ---
# Email alerts read these values ONLY from this file — they are not stored
# in the database and cannot be edited in the web UI. After changing them,
# restart the app (or `docker compose up -d` to recreate the container).
# Leave any of them blank to turn email alerts off.
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_USER_EMAIL=